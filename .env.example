# Copie para .env e preencha:  cp .env.example .env

# Domínio que vai servir o site (precisa de HTTPS: o navegador só deixa compartilhar a tela em https)
DOMAIN=tela.exemplo.com

# IP público IPv4 do servidor (usado pelo coturn e entregue aos navegadores como servidor TURN)
PUBLIC_IP=203.0.113.10

# Segredo compartilhado entre o servidor e o coturn. Gere com:  openssl rand -hex 32
TURN_SECRET=

# Porta local do site (o proxy HTTPS encaminha para 127.0.0.1:PORT)
PORT=3004

# Opcional: máximo de pessoas por sala (0 ou vazio = sem limite)
# MAX_PEERS=8

# Opcional: só aceitar WebSocket destas origens (separadas por vírgula). Vazio = qualquer.
# ALLOWED_ORIGINS=https://tela.exemplo.com
